# Copy to .env and customize before deploying.
# The passphrase unlocks the Root KEK. Losing it means losing all managed keys.
#
# For production, prefer a mounted secret FILE over this env var (env vars leak
# via `docker inspect` and /proc): set PQKMS_PASSPHRASE_FILE to the mount path
# (e.g. a Docker/K8s secret). It takes precedence over PQKMS_PASSPHRASE.
#
# The server also refuses to start without liboqs unless PQKMS_REQUIRE_PQ=0.
PQKMS_PASSPHRASE=change-me-to-a-strong-passphrase-with-real-entropy
# PQKMS_PASSPHRASE_FILE=/run/secrets/pqkms_passphrase
