# Default: normalize text files to LF in the repo
* text=auto eol=lf

# Explicit text files
*.py       text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
*.cfg      text eol=lf
*.ini      text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.ts       text eol=lf
*.sh       text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE    text eol=lf

# Binary files (no conversion, no diff noise)
*.docx  binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.whl   binary
*.so    binary
*.dll   binary
*.exe   binary
*.key   binary
*.pem   binary
*.db    binary
*.sqlite binary
*.sqlite3 binary
